# Copy to .env before running `docker compose up`.
# These are throwaway local-development credentials: the stack binds to
# localhost only and is never a production deployment.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root

# The address WordPress advertises as its own.
#
# Local by default. A GitHub Codespace overwrites this with its forwarded https
# address, because a browser running outside this machine cannot reach
# localhost:8080 - see .devcontainer/setup.sh.
WP_URL=http://localhost:8080

WP_PORT=8080
PMA_PORT=8081
